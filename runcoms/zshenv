# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

if command -v "systemctl" > /dev/null 2>&1; then
	eval $(systemctl --user show-environment | grep SSH_AUTH_SOCK)
	export SSH_AUTH_SOCK
fi

# When systemd manages gpg-agent with SSH support, set GPG_AGENT_INFO so
# prezto's gpg module does not try to start a second gpg-agent. GnuPG 2.1+
# ignores this variable; only the prezto module uses it for its start check.
if [[ -z "$GPG_AGENT_INFO" && -n "$SSH_AUTH_SOCK" && -S "$SSH_AUTH_SOCK" ]] \
   && [[ "$SSH_AUTH_SOCK" == */gnupg/S.gpg-agent.ssh ]]; then
	export GPG_AGENT_INFO="$SSH_AUTH_SOCK:0:1"
fi
