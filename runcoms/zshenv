# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# SSH agent is managed entirely by prezto's ssh module (modules/ssh/init.zsh).
# It starts ssh-agent on first shell launch, creates a persistent socket symlink
# under XDG_CACHE_HOME, and loads identities listed in:
#   zstyle ':prezto:module:ssh:load' identities 'id_ed25519'
# Do NOT import SSH_AUTH_SOCK from systemd here — on this system that picks up
# gpg-agent-ssh.socket, whose pinentry hangs in non-interactive prezto init.
