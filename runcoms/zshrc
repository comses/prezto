# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...
cdpath=($cdpath .. $HOME/workspace $HOME $HOME/Dropbox)
alias l='ls -AlFh'
alias memusg='ps -eo rss,pid,comm,args | sort -n'
alias rmbak='find . -name "*~" -delete -print'
alias usage='du -sh [A-z]** | sort -n'
alias drmi='docker rmi $(docker images -q --filter "dangling=true")'
alias lns='ss -estp'
alias llnet='netstat -atuv'
alias gno='xdg-open'
alias doc='docker compose'
function jql() {
    jq '.' "$1" | less
}
if [[ -n "$DISPLAY" ]] && command -v setxkbmap >/dev/null; then
    setxkbmap -option caps:none
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
