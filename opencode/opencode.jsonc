{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.4-mini-fast",
  "default_agent": "orchestrator",
  "shell": "/bin/zsh",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "provider": {
    "asu-rto": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ASU RTO",
      "options": {
        "baseURL": "https://openai.rc.asu.edu/v1"
      },
      "models": {
        "gemma4-31b-it": {
          "name": "Gemma 4 31B IT"
        },
        "glm-5-2": {
          "name": "GLM-5.2"
        },
        "kimi-k2-7-code": {
          "name": "Kimi K2.7 Code"
        },
        "laguna-s-2-1": {
          "name": "Laguna S 2.1"
        },
        "qwen35-27b": {
          "name": "Qwen 3.5 27B"
        }
      }
    }
  },
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "plugin": [
    "./oh-my-opencode-slim"
  ],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git push *": "ask"
    },
    "external_directory": "ask"
  }
}
