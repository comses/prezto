{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.5",
  "default_agent": "orchestrator",
  "shell": "/bin/zsh",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "provider": {
    "asu-rto": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ASU RTO",
      "options": {
        "baseURL": "https://openai.rc.asu.edu/v1"
      },
      "models": {
        "gemma4-31b-it": {
          "name": "Gemma 4 31B IT",
          "limit": { "context": 80000, "input": 64000, "output": 16000 }
        },
        "glm-5-2": {
          "name": "GLM-5.2",
          "limit": { "context": 90000, "input": 96000, "output": 24000 }
        },
        "qwen3-coder-30b-a3b-instruct": {
            "name": "qwen3 coder 30b a3b instruct",
            "limit": { "context": 80000, "input": 68000, "output": 12000 }
        },
        "kimi-k2-7-code": {
          "name": "Kimi K2.7 Code",
          "limit": { "context": 80000, "input": 64000, "output": 16000 }
        },
        "laguna-s-2-1": {
          "name": "Laguna S 2.1",
          "limit": { "context": 80000, "input": 64000, "output": 16000 }
        },
        "qwen38-27b": {
          "name": "Qwen 3.8 27B",
          "limit": { "context": 160000, "input": 136000, "output": 24000 }
        },
        "north-mini-code": {
          "name": "North Mini Code",
          "limit": { "context": 160000, "input": 136000, "output": 24000 }
        },
        "ornith-1-0-35b": {
          "name": "Ornith 1.0 35B",
          "limit": { "context": 160000, "input": 136000, "output": 24000 }
        },
        "qwen3-vl-32b-thinking": {
          "name": "Qwen3vl 32b-thonk",
          "limit": { "context": 80000, "input": 64000, "output": 16000 }
        }
      }
    }
  },
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "plugin": [
    "./oh-my-opencode-slim"
  ],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git push *": "ask"
    },
    "external_directory": "ask"
  }
}
